{
  "name": "fetchomatic",
  "version": "0.0.3",
  "description": "Wrap fetch with retries, timeout, logging, caching, error handling and more",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "keywords": [
    "fetch",
    "http",
    "promise",
    "request",
    "curl",
    "wget",
    "xhr",
    "whatwg",
    "https",
    "http2",
    "get",
    "got",
    "url",
    "uri",
    "request",
    "simple",
    "curl",
    "wget",
    "fetch",
    "net",
    "network",
    "gzip",
    "brotli",
    "requests",
    "human-friendly",
    "axios",
    "superagent",
    "node-fetch",
    "ky"
  ],
  "author": "fetch",
  "license": "ISC",
  "files": [
    "dist",
    "*.md"
  ],
  "packageManager": "pnpm@8.15.6",
  "scripts": {
    "test": "playwright test",
    "test-all": "pnpm build && curl 'http://localhost:7001/health' && concurrently 'npm:test:*'",
    "test:node": "playwright test",
    "test:deno": "DENO_NO_PACKAGE_JSON=true deno test test/deno --no-check --allow-net --allow-read",
    "test:bun": "bun test test/bun",
    "test:pkg": "(cd test/pkg && pnpm add-local-fetchomatic) && TEST_DIR=test/pkg pnpm test",
    "test-server": "tsx test/server.ts",
    "playwright": "playwright",
    "playwright:browsers": "playwright install --with-deps",
    "eslint": "eslint --max-warnings 0",
    "lint": "tsc && eslint .",
    "build": "rm -rf dist && tsc -p tsconfig.lib.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.36.1",
    "@types/express": "^4.17.17",
    "@types/node": "^18.16.3",
    "concurrently": "^8.2.0",
    "eslint": "8.57.0",
    "eslint-plugin-mmkal": "https://pkg.pr.new/mmkal/eslint-plugin-codegen/eslint-plugin-mmkal@a116067",
    "expect-type": "^0.15.0",
    "express": "^4.18.2",
    "isomorphic-fetch": "^3.0.0",
    "keyv": "5.5.1",
    "make-fetch-happen": "^11.1.1",
    "minipass-fetch": "^3.0.3",
    "next": "^13.4.1",
    "node-fetch": "^2.6.2",
    "np": "10.0.3",
    "strip-indent": "^4.0.0",
    "tsx": "4.7.2",
    "typescript": "5.0.4",
    "xstate": "^4.37.2",
    "zod": "4.0.17"
  }
}
